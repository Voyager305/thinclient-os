# Фрагмент конфига busybox (мерджится поверх дефолтного).
# NTPD: клиент синхронизации времени — нужен для NLA/Kerberos (RDP не пустит
# при расхождении часов, а у тонкого клиента RTC может врать/сесть).
CONFIG_NTPD=y
# CONFIG_FEATURE_NTPD_SERVER is not set
# WATCHDOG: демон, который «кормит» /dev/watchdog (иначе железо ребутнет)
CONFIG_WATCHDOG=y
