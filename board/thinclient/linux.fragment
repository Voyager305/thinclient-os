# Всё встроено в ядро (=y), чтобы не возиться с модулями в initramfs

# devtmpfs, чтобы /dev наполнялся сам
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Графика: framebuffer-консоль для меню.
# i915 — старые чипсеты 945GSE (Atom N270 и т.п.), даёт KMS.
# gma500 — Poulsbo/Cedar Trail (GMA 500/600/3600/3650), KMS без ускорения — для RDP хватает.
CONFIG_FB=y
CONFIG_FB_VESA=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_AGP=y
CONFIG_AGP_INTEL=y
CONFIG_DRM_I915=y
CONFIG_DRM_GMA500=y

# Флешка: USB + vfat
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_UHCI_HCD=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y

# Загрузка с ISO (тест в виртуалке: ISO подключается как CD)
CONFIG_ISO9660_FS=y
CONFIG_BLK_DEV_SR=y

# Виртуальные GPU (UTM/QEMU/VirtualBox): KMS-framebuffer высокого разрешения
# вместо текстового режима 80x25 — консоль чётче, X работает без vga=-хаков
CONFIG_DRM_BOCHS=y
CONFIG_DRM_CIRRUS_QEMU=y
CONFIG_DRM_VMWGFX=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_VIRTIO_NET=y

# Сетевухи, которые обычно стоят в атомных тонких клиентах/неттопах.
# E1000 и PCNET32 — заодно покрывают виртуалки (VirtualBox/QEMU).
CONFIG_E1000=y
CONFIG_E1000E=y
CONFIG_E100=y
CONFIG_R8169=y
CONFIG_8139TOO=y
CONFIG_ATL1C=y
CONFIG_ATL1E=y
CONFIG_SKY2=y
CONFIG_PCNET32=y

# Ввод для X
CONFIG_INPUT_EVDEV=y

# USB-принтеры (проброс в RDP-сессию через CUPS + канал printer)
CONFIG_USB_PRINTER=y
