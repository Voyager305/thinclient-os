# Пользователи, вшиваемые в образ (Buildroot mkusers).
# Формат: username uid group gid password home shell groups comment
#   password:  =<текст>  -> Buildroot зашифрует (sha-512, т.к. PASSWD_SHA512);
#              аккаунт активен. '!' — заблокирован, '*' — без входа по паролю.
#   uid/gid -1 -> Buildroot выберет автоматически; group user создастся сам.
#
# user/1234 — непривилегированный вход по SSH (+ sudo, см. /etc/sudoers.d).
# ВНИМАНИЕ: 1234 — СЛАБЫЙ пароль. Поменяй здесь и пересобери, либо `passwd`
# в рантайме (эфемерно — система в RAM). Root-пароль задаётся отдельно
# (TC_ROOT_PASSWORD при сборке).
user -1 user -1 =1234 /home/user /bin/bash - Thin client SSH user
