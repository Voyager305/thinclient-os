#!/bin/sh
# Обёртка вокруг tc-launcher (ncurses-интерфейс). Крутится на tty1 вместо
# getty (см. /etc/inittab): лаунчер рисует UI и пишет выбор в /tmp/tc-choice,
# здесь выбор исполняется — RDP-сессия, консоль, запись сервера, питание.

CONF=/mnt/flash/servers.conf
PASS_FILE=/mnt/flash/shell.pass
OUT=/tmp/tc-choice
TAB=$(printf '\t')
export TERM=linux

save_server() {
    # формат не должен ломаться, что бы ни пришло: точки с запятой и
    # переводы строк из полей выкидываем
    name=$(printf '%s' "$1" | tr -d ';\r\n')
    addr=$(printf '%s' "$2" | tr -d ';\r\n ')
    [ -n "$name" ] && [ -n "$addr" ] || return

    mount -o remount,rw /mnt/flash 2>/dev/null
    # если файл не кончается переводом строки — новая запись приклеится
    # к последней (так один раз и похерился conf), добиваем разделитель
    if [ -s "$CONF" ] && [ -n "$(tail -c1 "$CONF" 2>/dev/null)" ]; then
        printf '\r\n' >> "$CONF" 2>/dev/null
    fi
    if printf '%s;%s\r\n' "$name" "$addr" >> "$CONF" 2>/dev/null; then
        sync
    else
        clear
        echo "Cannot save: read-only media (ISO image)."
        echo "Persistent server list needs the usb.img build."
        sleep 2
    fi
    mount -o remount,ro /mnt/flash 2>/dev/null
}

# Перезаписать servers.conf: строку, ТОЧНО совпадающую с $1, заменить на $2
# (пусто → удалить). Остальные строки (в т.ч. комментарии) сохраняются как есть.
_rewrite_conf() {
    old=$1; new=$2
    [ -f "$CONF" ] || return
    if ! mount -o remount,rw /mnt/flash 2>/dev/null; then
        clear
        echo "Read-only media — cannot modify the server list."
        sleep 2
        return
    fi
    tmp="$CONF.tmp"
    while IFS= read -r ln || [ -n "$ln" ]; do
        cur=$(printf '%s' "$ln" | tr -d '\r')
        if [ "$cur" = "$old" ]; then
            [ -n "$new" ] && printf '%s\r\n' "$new"
        else
            printf '%s\n' "$ln"
        fi
    done < "$CONF" > "$tmp"
    mv "$tmp" "$CONF" 2>/dev/null && sync
    mount -o remount,ro /mnt/flash 2>/dev/null
}

delete_server() { _rewrite_conf "$1" ""; }      # $1 = "name;ip"
edit_server()   { _rewrite_conf "$1" "$2"; }     # $1 = старое, $2 = новое

# Консоль по умолчанию БЕЗ пароля. Админ может её запаролить: положить на
# флешку shell.pass с sha256-хэшем пароля — тогда консоль спросит его.
# Создать: printf '%s' 'пароль' | sha256sum | cut -c1-64 > /mnt/flash/shell.pass
check_pass() {
    [ -f "$PASS_FILE" ] || return 0
    clear
    printf "Password: "
    stty -echo
    read -r try
    stty echo
    printf "\n"
    hash=$(printf '%s' "$try" | sha256sum | cut -c1-64)
    stored=$(tr -d ' \t\r\n' < "$PASS_FILE")
    if [ "$hash" != "$stored" ]; then
        echo "Wrong password"
        sleep 1
        return 1
    fi
}

open_shell() {
    check_pass || return
    clear
    echo "=== Linux console (root). Back to menu: exit or Ctrl-D ==="
    echo "Flash is mounted read-only. To edit files on it use:"
    echo "  tc-edit            edit servers.conf"
    echo "  tc-edit <file>     edit any file on /mnt/flash"
    # HOME обязателен: без него bash -l не найдёт /root/.bash_profile
    # и останется с голым PS1='# ' из скелетного /etc/profile
    export HOME=/root
    cd /root
    if [ -x /bin/bash ]; then
        /bin/bash -l
    else
        /bin/sh -l
    fi
    cd /
}

run_session() {   # $1 = сервер; код возврата = rc сессии (255 = X не поднялся)
    clear
    echo "Connecting to $1 ..."
    rm -f /tmp/rdp-status
    # X живёт только пока идёт RDP-сессия; вышел из Windows — вернулся в меню
    xinit /usr/bin/tc-session "$1" -- -nolisten tcp >/var/log/xsession.log 2>&1
    # если X умер грязно и оставил VT в графическом режиме — вернуть консоль
    chvt 1 2>/dev/null
    rc=$(cat /tmp/rdp-status 2>/dev/null)
    [ -n "$rc" ] || rc=255
    return "$rc"
}

connect() {   # ручное подключение из меню: при провале — экран ошибки
    run_session "$1"
    rc=$?
    if [ "$rc" = 255 ]; then
        connect_error "$1" "X server failed to start"
    elif [ "$rc" != 0 ]; then
        connect_error "$1" "xfreerdp exited with code $rc"
    fi
}

# Киоск-failover: AUTOCONNECT может быть списком через запятую. Пробуем по
# порядку до первой НОРМАЛЬНО завершившейся сессии (rc 0 = пользователь
# вышел сам). Если ни один не поднялся — один экран ошибки.
autoconnect_list() {
    last=""
    OLDIFS=$IFS
    IFS=,
    for srv in $1; do
        IFS=$OLDIFS
        srv=$(printf '%s' "$srv" | tr -d ' \t\r')
        [ -n "$srv" ] || { IFS=,; continue; }
        last="$srv"
        run_session "$srv" && return 0
        IFS=,
    done
    IFS=$OLDIFS
    [ -n "$last" ] && connect_error "$last" "autoconnect: no server reachable"
    return 1
}

connect_error() {
    clear
    echo "=== Connection to $1 failed ($2) ==="
    echo
    echo "Last errors from /var/log/xsession.log:"
    grep -iE 'ERR|error|denied|refused|timeout|unreachable|failed' \
        /var/log/xsession.log | tail -6
    echo
    echo "Check: server address, network cable, ip in the corner of the menu."
    echo "Full log: console -> less /var/log/xsession.log"
    echo
    printf "Press Enter to return to the menu..."
    read -r _
}

# Экран диагностики: сеть, ping до шлюза, последние ошибки RDP-сессии.
# Без ухода в шелл — всё из меню.
run_diag() {
    clear
    echo "=== Diagnostics ==="
    echo "Host: $(hostname)   Version: $(cat /etc/tc-release 2>/dev/null)"
    echo
    echo "-- Interfaces --"
    ip -br addr 2>/dev/null | grep -v '^lo '
    echo "-- Routes --"
    ip route 2>/dev/null
    echo "-- DNS --"
    grep -v '^#' /etc/resolv.conf 2>/dev/null
    echo
    GW=$(ip route 2>/dev/null | awk '/^default/{print $3; exit}')
    if [ -n "$GW" ]; then
        echo "-- Ping gateway $GW --"
        ping -c 2 -W 1 "$GW" 2>&1 | tail -2
    else
        echo "(нет шлюза по умолчанию)"
    fi
    echo
    echo "-- Последние ошибки RDP-сессии --"
    grep -iE 'error|denied|refused|timeout|unreachable|failed' \
        /var/log/xsession.log 2>/dev/null | tail -5
    echo
    printf "Press Enter to return to the menu..."
    read -r _
}

# Экран управления серверами: лаунчер в режиме --manage возвращает одно
# действие (ADD/EDIT/DELETE/BACK), применяем и снова показываем экран,
# пока не BACK/пусто. Вывод лаунчера НЕ перехватываем (ncurses рисует в
# терминал) — действие читаем из файла $OUT.
manage_loop() {
    while true; do
        rm -f "$OUT"
        /usr/bin/tc-launcher --manage
        a=$(cat "$OUT" 2>/dev/null)
        case "$a" in
            ADD\ *)
                entry=${a#ADD }
                name=${entry%%;*}
                addr=${entry#*;}
                [ -n "$name" ] && [ -n "$addr" ] && save_server "$name" "$addr"
                ;;
            DELETE\ *)
                delete_server "${a#DELETE }"
                ;;
            EDIT\ *)
                rest=${a#EDIT }
                old=${rest%%"$TAB"*}
                new=${rest#*"$TAB"}
                [ "$old" != "$new" ] && edit_server "$old" "$new"
                ;;
            *)
                break
                ;;
        esac
    done
}

while true; do
    # сеть могла появиться позже загрузки — лаунчер покажет ip, как только он есть
    ip -4 -o addr show scope global 2>/dev/null | grep -q . || /usr/bin/tc-netup 2>/dev/null

    # киоск: автоподключение ОДИН раз за загрузку (tc.conf AUTOCONNECT).
    # Флаг ставим до connect — если сервер недоступен, показываем меню,
    # а не зацикливаемся на автоконнекте (админ должен добраться до меню).
    if [ ! -f /tmp/tc-autodone ]; then
        : > /tmp/tc-autodone
        auto=$(/usr/bin/tc-getconf AUTOCONNECT)
        if [ -n "$auto" ]; then
            autoconnect_list "$auto"
            continue
        fi
    fi

    rm -f "$OUT"
    /usr/bin/tc-launcher
    action=$(cat "$OUT" 2>/dev/null)

    case "$action" in
        CONNECT\ *)
            connect "${action#CONNECT }"
            ;;
        MANAGE)
            manage_loop
            ;;
        DIAG)
            run_diag
            ;;
        SHELL)
            open_shell
            ;;
        REBOOT)
            reboot
            ;;
        POWEROFF)
            poweroff
            ;;
        *)
            # лаунчер умер без выбора — не крутить respawn бешено
            sleep 1
            ;;
    esac
done
