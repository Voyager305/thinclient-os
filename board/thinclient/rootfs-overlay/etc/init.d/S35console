#!/bin/sh
# Консольный шрифт с кириллицей (иначе русский текст в меню — кракозябры).
# Шрифты ставятся пакетом kbd (см. defconfig).
case "$1" in
    start)
        for t in /dev/tty1 /dev/tty2; do
            setfont UniCyr_8x16 -C "$t" 2>/dev/null \
                || setfont cyr-sun16 -C "$t" 2>/dev/null
        done
        psplash-write "PROGRESS 30" 2>/dev/null
        ;;
esac
