#!/bin/sh
# Заставка с прогресс-баром на время загрузки. Если framebuffer'а нет
# (совсем древний VESA-режим) — тихо пропускаем, система грузится как обычно.
case "$1" in
    start)
        [ -e /dev/fb0 ] || exit 0
        psplash &
        # даём заставке создать fifo
        n=0
        while [ ! -p /tmp/psplash_fifo ] && [ "$n" -lt 10 ]; do
            n=$((n + 1))
            sleep 0.1
        done
        psplash-write "PROGRESS 10" 2>/dev/null
        ;;
esac
