#!/bin/sh
# Сеть тонкого клиента: hostname tc-<mac>, lo, DHCP на всех проводных
# интерфейсах. Файл перекрывает скелетный S40network Buildroot'а (ifupdown).
case "$1" in
    start)
        # hostname tc-<MAC без разделителей> по первому сетевому интерфейсу —
        # клиент видно и в DHCP leases, и в RDP-сессии на сервере
        for path in /sys/class/net/*; do
            iface=$(basename "$path")
            [ "$iface" = "lo" ] && continue
            mac=$(tr -d ':\n' < "$path/address" 2>/dev/null)
            if [ -n "$mac" ]; then
                hostname "tc-$mac"
                echo "tc-$mac" > /etc/hostname
                break
            fi
        done

        ip link set lo up
        ip addr add 127.0.0.1/8 dev lo 2>/dev/null

        for path in /sys/class/net/*; do
            iface=$(basename "$path")
            [ "$iface" = "lo" ] && continue
            ip link set "$iface" up
            udhcpc -i "$iface" -b -t 5 -A 10 \
                -x hostname:"$(hostname)" >/dev/null 2>&1 &
        done
        ;;
    stop)
        killall udhcpc 2>/dev/null
        ;;
esac
