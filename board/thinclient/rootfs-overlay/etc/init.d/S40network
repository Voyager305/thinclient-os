#!/bin/sh
# Сеть тонкого клиента. Файл перекрывает скелетный S40network Buildroot'а.
# Вся логика (hostname tc-<mac>, DHCP) — в идемпотентном /usr/bin/tc-netup;
# меню дозовёт его само, если интерфейс появится позже.
case "$1" in
    start)
        ip link set lo up
        ip addr add 127.0.0.1/8 dev lo 2>/dev/null

        # подождём до 3 секунд, пока ядро увидит хоть одну сетевуху
        n=0
        while [ "$n" -lt 15 ]; do
            [ -n "$(ls /sys/class/net 2>/dev/null | grep -v '^lo$')" ] && break
            n=$((n + 1))
            sleep 0.2
        done
        /usr/bin/tc-netup
        psplash-write "PROGRESS 60" 2>/dev/null
        ;;
    stop)
        killall udhcpc 2>/dev/null
        ;;
esac
