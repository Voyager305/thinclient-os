#!/bin/sh
# Сеть тонкого клиента: lo + DHCP на всех проводных интерфейсах, каким бы
# именем их ни назвали (eth0/enp1s0...). Файл перекрывает скелетный
# S40network Buildroot'а (ifupdown), чтобы сеть поднималась в одном месте.
case "$1" in
    start)
        ip link set lo up
        ip addr add 127.0.0.1/8 dev lo 2>/dev/null
        for path in /sys/class/net/*; do
            iface=$(basename "$path")
            [ "$iface" = "lo" ] && continue
            ip link set "$iface" up
            udhcpc -i "$iface" -b -t 5 -A 10 >/dev/null 2>&1 &
        done
        ;;
    stop)
        killall udhcpc 2>/dev/null
        ;;
esac
