# tc.conf — необязательный конфиг тонкого клиента. Кладётся на флешку рядом
# с servers.conf (FAT-раздел / TCDATA). Формат: KEY=значение, по одному в
# строке; строки с # — комментарии. Файл НЕ исполняется (только чтение
# известных ключей), так что вписывать сюда shell-команды бессмысленно.
#
# Значения — латиницей. Убери # перед нужной строкой.

# --- RDP: предзаполнение окна входа ---------------------------------------
# Логин и домен подставляются в xfreerdp (пароль пользователь вводит сам).
#RDP_USER=ivanov
#RDP_DOMAIN=CORP

# Любые доп. флаги xfreerdp (через пробел). Примеры:
#   /sound:sys:alsa      звук
#   /bpp:32              полная цветность (по умолчанию 16 — быстрее)
#   +fonts /gfx          сглаживание шрифтов / RDP GFX
#RDP_EXTRA=/sound:sys:alsa

# --- Киоск: автоподключение при загрузке ----------------------------------
# ip или имя сервера из servers.conf. Клиент один раз за загрузку сразу идёт
# в RDP; после выхода из сессии показывается обычное меню.
#AUTOCONNECT=192.168.0.4

# --- Сеть -----------------------------------------------------------------
# Имя хоста вместо tc-<mac> (видно в DHCP-lease и в RDP-сессии на сервере).
#HOSTNAME=buh-01

# Статический IP вместо DHCP. Пусто/закомментировано → DHCP на всех
# интерфейсах (по умолчанию). Задавай ТРИ ключа вместе: без GATEWAY не будет
# маршрута по умолчанию, без DNS — не будет резолвинга имён.
#STATIC_IP=192.168.0.50/24
#GATEWAY=192.168.0.1
#DNS=192.168.0.1

# --- Время и раскладка ----------------------------------------------------
# NTP-сервер для синхронизации часов. Нужен для RDP-логина (NLA/Kerberos не
# пускают при расхождении времени, а RTC на клиенте может врать/сесть).
#NTP_SERVER=192.168.0.1

# Раскладка консоли для tty2-логина и ввода в меню (например us, ru, de).
# RDP-раскладку задавай через RDP_EXTRA (напр. /kbd:0x00000409).
#KEYMAP=us
